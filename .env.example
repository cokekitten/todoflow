# Cron endpoint protection
CRON_SECRET=change-me-to-a-random-string

# Optional: Telegram fallback (prefer settings page config)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Cron setup example (add to system crontab):
# Run every 30 minutes to check reminder windows
# */30 * * * * curl -s -X POST -H "Authorization: Bearer YOUR_CRON_SECRET" http://localhost:3916/api/reminders/trigger
